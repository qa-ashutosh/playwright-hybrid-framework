{
  "name": "playwright-hybrid-framework",
  "version": "2.0.0",
  "description": "Hybrid UI + API test automation framework using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-tests",
    "test:api": "playwright test --project=api-tests",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:firefox": "playwright test --project=ui-tests-firefox",
    "test:visual": "playwright test --project=visual-tests",
    "test:a11y": "playwright test --project=a11y-tests",
    "test:visual:update": "playwright test --project=visual-tests --update-snapshots",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@axe-core/playwright": "^4.9.0",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "dotenv": "^16.4.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "allure-playwright": "^3.0.0",
    "allure-commandline": "^2.29.0"
  }
}
